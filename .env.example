# Copia este archivo como .env y rellena los valores.
# ¡NUNCA subas el archivo .env a GitHub!

PORT=3000

# Supabase → Project Settings → Data API / API Keys
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=tu-clave-secret-o-service_role

# Clave para firmar los tokens JWT (texto largo y aleatorio)
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
JWT_EXPIRES_IN=1h
